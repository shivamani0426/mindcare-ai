# Copy to .env for local development only. Never commit real passwords.
SECRET_KEY=replace-with-long-random-secret
DATABASE_URL=sqlite:///mindcare_local.db
SECURE_COOKIES=0

# Google OAuth Web application credentials (optional for local email login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

# Optional Resend HTTPS transactional email; verified sending domain required
RESET_EMAIL_API_KEY=
RESET_FROM_EMAIL=

# Optional relay; prefer time-limited coturn REST credentials
TURN_URL=
TURN_SHARED_SECRET=
